APP_NAME="mini-rag"
APP_VERSION="0.1.0"
OpenAI_API_KEY="your_openai_api_key_here"
FILE_CHUNK_SIZE=524288  # 512 KB
FILE_ALLOWED_EXTENSIONS=["text/plain", "application/pdf", "image/png", "image/jpeg"]
FILE_MAX_SIZE=10

MONOGO_DB_URL="mongodb://admin:admin@localhost:27007"
MONGO_DB_NAME="mini-rag"

# =============== LLM CONFIGURATION ===============

GENERATION_BACKEND= "OPENAI"
EMBEDDING_BACKEND= "COHERE"

OpenAI_API_KEY=""
COHERE_API_KEY=""

GENERATION_MODEL_ID="GPT-3.5-turbo"
EMBEDDING_MODEL_ID ="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

DEFAULT_MAX_INPUT_CHARACTER=1024
DEFAULT_MAX_OUTPUT_CHARACTER=200
GENERATION_DAFAULT_TEMPERATURE=0.1